# carry-platform 환경변수 예시 (dev/prod 프로파일)
#
# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다. .env 는 커밋하지 않는다.
# local 프로파일은 대부분 기본값이 박혀 있어 별도 설정 없이 동작한다(스크립트: ./scripts/dev-up.sh).

# ── 보안 ──
# JWT 서명 비밀키. HS256(256-bit)이라 최소 32자 이상의 강한 임의 문자열이어야 한다.
# 미설정·32자 미만이면 JwtSecretValidator 가 기동을 실패시킨다(fail-fast).
JWT_SECRET=change-me-to-a-strong-random-string-at-least-32-bytes

# ── 데이터베이스 (PostgreSQL) ──
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/carry
SPRING_DATASOURCE_USERNAME=carry
SPRING_DATASOURCE_PASSWORD=change-me

# ── Redis (refresh 토큰·멱등성·ShedLock·Geo 캐시) ──
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ── Kafka ──
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CARRY_KAFKA_REPLICATION_FACTOR=3
CARRY_KAFKA_MIN_INSYNC_REPLICAS=2

# ── 외부 API: Naver 지오코딩 ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 외부 API: AWS S3 (미디어 업로드) ──
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=

# ── 관측성 (OpenTelemetry / OTLP) ──
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
MANAGEMENT_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
TRACING_SAMPLING_PROBABILITY=1.0

# ── Kakao 로그인 (선택; dev/stg e2e 에서 스텁 서버로 오버라이드) ──
# KAKAO_API_BASE_URL=https://kapi.kakao.com
